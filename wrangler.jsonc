{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cidade-das-brumas",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-23",
  "d1_databases": [
    {
      "binding": "MATCHES_DB",
      "database_name": "cidade-das-brumas",
    },
  ],
  "ratelimits": [
    {
      "name": "API_IP_RATE_LIMITER",
      "namespace_id": "91571423",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "MATCH_SESSION_RATE_LIMITER",
      "namespace_id": "91571424",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    "not_found_handling": "single-page-application",
  },
}
